---
import type { CollectionEntry } from 'astro:content';
import FormattedDateRange from '../components/FormattedDateRange.astro';
import SmartImage from '../components/SmartImage.astro';
import { pageTitle, SITE_TITLE } from '../consts';
import BaseLayout from './BaseLayout.astro';

type Props = Pick<
	CollectionEntry<'trips'>['data'],
	'title' | 'description' | 'startDate' | 'endDate' | 'heroImage'
> & {
	slug: string;
};

const { title, description, startDate, endDate, heroImage, slug } = Astro.props;
const metaDescription =
	description || `Travel notes and photos from ${title} by ${SITE_TITLE}.`;
const pageUrl = new URL(`/trips/${slug}/`, Astro.site).href;
const imageUrl = heroImage ? new URL(heroImage, Astro.site).href : undefined;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: metaDescription,
	url: pageUrl,
	...(imageUrl ? { image: [imageUrl] } : {}),
	datePublished: startDate.toISOString(),
	...(endDate ? { dateModified: endDate.toISOString() } : { dateModified: startDate.toISOString() }),
	author: {
		'@type': 'Person',
		name: SITE_TITLE,
		url: Astro.site?.href,
	},
	publisher: {
		'@type': 'Person',
		name: SITE_TITLE,
		url: Astro.site?.href,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageUrl,
	},
};
---

<BaseLayout
	title={pageTitle(title)}
	description={metaDescription}
	image={heroImage}
	type="article"
	publishedTime={startDate}
	updatedTime={endDate}
	jsonLd={jsonLd}
>
	<article>
		<div class="hero-image">
			<SmartImage width={1020} height={510} src={heroImage} alt={title} quality={100} />
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDateRange startDate={startDate} endDate={endDate} />
				</div>
				<h1>{title}</h1>
				{description && <p class="description">{description}</p>}
				<hr />
			</div>
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.hero-image {
		display: flex;
		align-items: center;
		width: 100%;
		max-width: 1020px;
		max-height: 510px;
		margin: 0 auto;
		overflow: hidden;
		border-radius: var(--radius-lg, 0.75rem);
	}
	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		flex-shrink: 0;
	}
	.prose {
		width: 720px;
		max-width: calc(100% - var(--size-6, 2rem));
		margin: auto;
		padding: var(--size-4, 1rem);
		color: var(--text-primary, #1c1b22);
	}
	.title {
		margin-bottom: var(--size-4, 1rem);
		padding: var(--size-4, 1rem) 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 var(--size-2, 0.5rem) 0;
	}

	.description {
		margin: 0 0 var(--size-2, 0.5rem);
		color: var(--text-muted, #55545f);
		font-size: var(--font-size-lg, 1.125rem);
		line-height: var(--line-height-normal, 1.5);
	}

	.date {
		margin-bottom: var(--size-2, 0.5rem);
		color: var(--text-muted, #55545f);
	}
</style>
