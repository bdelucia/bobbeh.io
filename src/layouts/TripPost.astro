---
import type { CollectionEntry } from 'astro:content';
import FormattedDateRange from '../components/FormattedDateRange.astro';
import SmartImage from '../components/SmartImage.astro';
import BaseLayout from './BaseLayout.astro';

type Props = Pick<CollectionEntry<'trips'>['data'], 'title' | 'description' | 'startDate' | 'endDate' | 'heroImage'>;

const { title, description, startDate, endDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article>
		<div class="hero-image">
			<SmartImage width={1020} height={510} src={heroImage} alt="" />
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDateRange startDate={startDate} endDate={endDate} />
				</div>
				<h1>{title}</h1>
				<hr />
			</div>
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.hero-image {
		width: 100%;
		max-width: 1020px;
		margin: 0 auto;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: var(--radius-lg, 0.75rem);
	}
	.prose {
		width: 720px;
		max-width: calc(100% - var(--size-6, 2rem));
		margin: auto;
		padding: var(--size-4, 1rem);
		color: var(--text-primary, #1c1b22);
	}
	.title {
		margin-bottom: var(--size-4, 1rem);
		padding: var(--size-4, 1rem) 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 var(--size-2, 0.5rem) 0;
	}

	.date {
		margin-bottom: var(--size-2, 0.5rem);
		color: var(--text-muted, #55545f);
	}
</style>
