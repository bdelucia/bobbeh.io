---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArticlePlaceholderImage from '../assets/article-placeholder.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import BaseLayout from './BaseLayout.astro';

type Props = Pick<CollectionEntry<'articles'>['data'], 'title' | 'description'> & {
	pubDate?: CollectionEntry<'articles'>['data']['pubDate'];
	updatedDate?: CollectionEntry<'articles'>['data']['updatedDate'];
	heroImage?: CollectionEntry<'articles'>['data']['heroImage'];
	tags?: CollectionEntry<'articles'>['data']['tags'];
};

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
const image = heroImage ?? ArticlePlaceholderImage;
---

<BaseLayout title={title} description={description} image={image}>
	<article>
		<div class="hero-image">
			<Image width={1020} height={510} src={image} alt="" />
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					{pubDate && <FormattedDate date={pubDate} />}
					{
						updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				<TagList tags={tags} />
				<hr />
			</div>
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.hero-image {
		width: 100%;
		max-width: 1020px;
		margin: 0 auto;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: var(--radius-lg, 0.75rem);
	}
	.prose {
		width: 720px;
		max-width: calc(100% - var(--size-6, 2rem));
		margin: auto;
		padding: var(--size-4, 1rem);
		color: var(--text-primary, #1c1b22);
	}
	.title {
		margin-bottom: var(--size-4, 1rem);
		padding: var(--size-4, 1rem) 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 var(--size-2, 0.5rem) 0;
	}

	.title :global(.tag-list) {
		justify-content: center;
	}

	.date {
		margin-bottom: var(--size-2, 0.5rem);
		color: var(--text-muted, #55545f);
	}
	.last-updated-on {
		font-style: italic;
	}
</style>
