---
import type { CollectionEntry } from 'astro:content';
import SmartImage from '../components/SmartImage.astro';
import BaseLayout from './BaseLayout.astro';

type Props = Pick<CollectionEntry<'articles'>['data'], 'title' | 'description'> & {
	heroImage?: CollectionEntry<'articles'>['data']['heroImage'];
};

const { title, description, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article>
		<div class="hero-image">
			<SmartImage width={1020} height={510} src={heroImage} alt="" />
		</div>
		<div class="prose">
			<div class="title">
				<h1>{title}</h1>
				{description && <p class="description">{description}</p>}
				<hr />
			</div>
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.hero-image {
		display: flex;
		align-items: center;
		width: 100%;
		max-width: 1020px;
		max-height: 510px;
		margin: 0 auto;
		overflow: hidden;
		border-radius: var(--radius-lg, 0.75rem);
	}
	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		flex-shrink: 0;
	}
	.prose {
		width: 1020px;
		max-width: 100%;
		margin: auto;
		padding: var(--size-6, 1.5rem);
		background-color: var(--bg-surface, #eae9e7);
		border-radius: 0 0 var(--radius-lg, 0.75rem) var(--radius-lg, 0.75rem);
		color: var(--text-primary, #1c1b22);
		box-sizing: border-box;
	}
	.title {
		display: flex;
		flex-direction: column;
		gap: var(--size-2, 0.5rem);
		text-align: start;
		line-height: 1;
	}
	.title h1 {
		font-size: 2.5rem;
		margin: 0;
	}

	.description {
		margin: 0;
		color: var(--text-muted, #55545f);
		font-size: var(--font-size-lg, 1.125rem);
		line-height: var(--line-height-normal, 1.5);
	}
</style>
