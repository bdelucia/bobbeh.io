---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/article-placeholder.jpg';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { optimizeCdnImageUrl } from '../lib/cdn-image';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	imageAlt?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	updatedTime?: Date;
	tags?: string[];
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	imageAlt,
	type = 'website',
	publishedTime,
	updatedTime,
	tags = [],
	jsonLd,
} = Astro.props;
const socialImageAlt = imageAlt || title;

const ogImage =
	typeof image === 'string'
		? new URL(
				optimizeCdnImageUrl(image, {
					width: 1200,
					height: 630,
					fit: 'cover',
					format: 'jpeg',
					quality: 85,
				}),
				Astro.site ?? Astro.url,
			)
		: new URL(image.src, Astro.url);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const sameAs = SOCIAL_LINKS.map((link) => link.href);

const defaultJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		alternateName: SITE_NAME,
		url: siteUrl.href,
		description: SITE_DESCRIPTION,
		inLanguage: 'en',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: SITE_TITLE,
		url: siteUrl.href,
		sameAs,
	},
];

const structuredData = [
	...defaultJsonLd,
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<script is:inline>
	(() => {
		const getTheme = () => {
			const stored = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			return stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
		};

		const applyTheme = (doc = document) => {
			doc.documentElement.dataset.theme = getTheme();
		};

		applyTheme();

		// ClientRouter swaps in a fresh <html> without data-theme; set it before paint.
		if (!window.__themeBeforeSwap) {
			window.__themeBeforeSwap = true;
			document.addEventListener('astro:before-swap', (event) => {
				applyTheme(event.newDocument);
			});
		}
	})();
</script>

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-caskaydia" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialImageAlt} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
{type === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && updatedTime && (
	<meta property="article:modified_time" content={updatedTime.toISOString()} />
)}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />

{structuredData.map((data) => (
	<script type="application/ld+json" set:html={JSON.stringify(data)} />
))}

<ClientRouter />
<script src="../scripts/nav-transition-direction.ts"></script>
<Analytics />
<SpeedInsights />
