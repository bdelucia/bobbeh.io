---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArticlePlaceholderImage from '../assets/article-placeholder.jpg';
import { optimizeCdnImageUrl } from '../lib/cdn-image';

interface Props {
	src?: string | ImageMetadata | null;
	alt?: string;
	width: number;
	height: number;
	class?: string;
	/** 1–100. CDN transform quality; default 80. */
	quality?: number;
}

const { src, alt = '', width, height, class: className, quality = 80 } = Astro.props;
const image = src ?? ArticlePlaceholderImage;
---

{
	typeof image === 'string' ? (
		<img
			class={className}
			src={optimizeCdnImageUrl(image, {
				width,
				height,
				format: 'auto',
				quality,
			})}
			alt={alt}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
		/>
	) : (
		<Image class={className} width={width} height={height} src={image} alt={alt} />
	)
}
