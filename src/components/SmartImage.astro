---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArticlePlaceholderImage from '../assets/article-placeholder.jpg';

interface Props {
	src?: string | ImageMetadata | null;
	alt?: string;
	width: number;
	height: number;
	class?: string;
}

const { src, alt = '', width, height, class: className } = Astro.props;
const image = src ?? ArticlePlaceholderImage;
const isRemote = typeof image === 'string';
---

{
	isRemote ? (
		<img
			class={className}
			src={image}
			alt={alt}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
		/>
	) : (
		<Image class={className} width={width} height={height} src={image} alt={alt} />
	)
}
