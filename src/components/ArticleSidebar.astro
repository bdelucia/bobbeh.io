---
import type { MarkdownHeading } from 'astro';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	pubDate?: Date;
	tags: string[];
	headings: MarkdownHeading[];
	embedded?: boolean;
}

interface HeadingGroup {
	heading: MarkdownHeading;
	children: MarkdownHeading[];
}

const { pubDate, tags, headings, embedded = false } = Astro.props;
const tocTitleId = embedded ? 'article-toc-title-embedded' : 'article-toc-title';
const tableOfContents = headings
	.filter(({ depth }) => depth === 1 || depth === 2)
	.reduce<HeadingGroup[]>((groups, heading) => {
		if (heading.depth === 1) {
			groups.push({ heading, children: [] });
		} else if (groups.length > 0) {
			groups.at(-1)?.children.push(heading);
		} else {
			groups.push({ heading, children: [] });
		}

		return groups;
	}, []);
---

<aside
	class:list={['article-sidebar', { 'article-sidebar--embedded': embedded }]}
	aria-label="Article information"
>
	{
		!embedded && pubDate && (
			<p class="article-sidebar__published">
				Published by Bobby DeLucia on <FormattedDate date={pubDate} />
			</p>
		)
	}

	{!embedded && tags.length > 0 && (
		<div class="article-sidebar__tags">
			<TagList tags={tags} />
		</div>
	)}

	{
		tableOfContents.length > 0 && (
			<nav class="article-sidebar__toc" aria-labelledby={tocTitleId}>
				<h2 id={tocTitleId}>Table of contents</h2>
				<ol>
					{tableOfContents.map(({ heading, children }) => (
						<li>
							<a href={`#${heading.slug}`}>{heading.text}</a>
							{children.length > 0 && (
								<ol>
									{children.map((child) => (
										<li>
											<a href={`#${child.slug}`}>{child.text}</a>
										</li>
									))}
								</ol>
							)}
						</li>
					))}
				</ol>
			</nav>
		)
	}
</aside>

<script>
	const DESKTOP_MQ = '(min-width: 1401px)';
	const READING_OFFSET = 120;

	let cleanup: (() => void) | undefined;

	function getLinkId(link: HTMLAnchorElement) {
		const href = link.getAttribute('href');
		if (!href?.startsWith('#')) return null;
		return decodeURIComponent(href.slice(1));
	}

	function setActiveLink(links: HTMLAnchorElement[], activeId: string | null) {
		for (const link of links) {
			const id = getLinkId(link);
			const isActive = Boolean(activeId) && id === activeId;
			link.classList.toggle('active', isActive);
			if (isActive) {
				link.setAttribute('aria-current', 'location');
			} else {
				link.removeAttribute('aria-current');
			}
		}
	}

	function setupTocSpy() {
		cleanup?.();
		cleanup = undefined;

		const toc = document.querySelector(
			'.article-sidebar:not(.article-sidebar--embedded) .article-sidebar__toc',
		);
		if (!toc) return;

		const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
		if (links.length === 0) return;

		const headings = links
			.map((link) => {
				const id = getLinkId(link);
				return id ? document.getElementById(id) : null;
			})
			.filter((heading): heading is HTMLElement => heading !== null);

		if (headings.length === 0) return;

		const media = window.matchMedia(DESKTOP_MQ);
		let frame = 0;

		function getActiveHeadingId() {
			let activeId = headings[0]?.id ?? null;

			for (const heading of headings) {
				if (heading.getBoundingClientRect().top <= READING_OFFSET) {
					activeId = heading.id;
				} else {
					break;
				}
			}

			return activeId;
		}

		function updateActive() {
			if (!media.matches) {
				setActiveLink(links, null);
				return;
			}

			setActiveLink(links, getActiveHeadingId());
		}

		function onScrollOrResize() {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				updateActive();
			});
		}

		updateActive();
		window.addEventListener('scroll', onScrollOrResize, { passive: true });
		window.addEventListener('resize', onScrollOrResize);
		media.addEventListener('change', updateActive);

		cleanup = () => {
			cancelAnimationFrame(frame);
			frame = 0;
			window.removeEventListener('scroll', onScrollOrResize);
			window.removeEventListener('resize', onScrollOrResize);
			media.removeEventListener('change', updateActive);
			setActiveLink(links, null);
		};
	}

	function onTocClick(event: MouseEvent) {
		if (event.defaultPrevented || event.button !== 0) return;
		if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;

		const target = event.target;
		if (!(target instanceof Element)) return;

		const link = target.closest('.article-sidebar__toc a[href^="#"]');
		if (!(link instanceof HTMLAnchorElement)) return;

		const id = getLinkId(link);
		if (!id) return;

		const heading = document.getElementById(id);
		if (!heading) return;

		// Capture-phase preventDefault so Astro's ClientRouter doesn't hijack the hash jump.
		event.preventDefault();
		event.stopPropagation();

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const top = heading.getBoundingClientRect().top + window.scrollY;

		window.scrollTo({
			top,
			behavior: reduceMotion ? 'auto' : 'smooth',
		});
		history.pushState(null, '', `#${id}`);
	}

	// Run immediately: ClientRouter can fire astro:page-load before this module registers.
	setupTocSpy();
	document.addEventListener('astro:page-load', setupTocSpy);
	document.addEventListener('click', onTocClick, true);
</script>

<style>
	.article-sidebar {
		position: sticky;
		top: var(--size-4, 1rem);
		display: flex;
		flex-direction: column;
		gap: var(--size-4, 1rem);
		padding: var(--size-4, 1rem);
		background: var(--bg-surface, #eae9e7);
		border: 1px solid var(--border-subtle, #d1cfcd);
		border-radius: var(--radius-lg, 0.75rem);
		box-sizing: border-box;
		font-size: 0.875rem;
		line-height: var(--line-height-normal, 1.5);
	}

	.article-sidebar--embedded {
		position: static;
		display: none;
		margin-bottom: var(--size-6, 2rem);
	}

	.article-sidebar__published {
		margin: 0;
		color: var(--text-muted, #55545f);
	}

	.article-sidebar :global(.tag-list) {
		margin: 0;
	}

	.article-sidebar :global(.tag) {
		font-size: 0.875rem;
	}

	.article-sidebar__toc {
		padding-top: var(--size-4, 1rem);
		border-top: 1px solid var(--border-subtle, #d1cfcd);
	}

	.article-sidebar__toc h2 {
		margin: 0 0 var(--size-3, 0.75rem);
		font-size: 1.125rem;
	}

	.article-sidebar__toc ol {
		display: flex;
		flex-direction: column;
		gap: var(--size-2, 0.5rem);
		margin: 0;
		padding-left: var(--size-5, 1.5rem);
		list-style: decimal;
	}

	.article-sidebar__toc ol ol {
		margin-top: var(--size-2, 0.5rem);
		padding-left: var(--size-4, 1rem);
		list-style: disc;
	}

	.article-sidebar__toc a {
		display: block;
		color: var(--text-primary, #1c1b22);
		line-height: var(--line-height-tight, 1.25);
		text-decoration: none;
		transition:
			color 0.15s ease,
			font-weight 0.15s ease;
	}

	.article-sidebar__toc a:hover {
		color: var(--accent-primary, #3584e4);
		text-decoration: underline;
	}

	.article-sidebar__toc :global(li:has(> a.active)::marker) {
		color: var(--accent-primary, #3584e4);
		font-weight: var(--font-weight-semibold, 600);
	}

	.article-sidebar__toc :global(a.active) {
		color: var(--accent-primary, #3584e4);
		font-weight: var(--font-weight-semibold, 600);
		text-decoration: none;
	}

	@media (max-width: 1400px) {
		.article-sidebar:not(.article-sidebar--embedded) {
			display: none;
		}

		.article-sidebar--embedded {
			display: flex;
			background: var(--bg-surface-hover, #dfdddb);
		}

		.article-sidebar--embedded :global(.article-sidebar__toc) {
			padding-top: 0;
			border-top: 0;
		}

		.article-sidebar--embedded :global(.article-sidebar__toc h2) {
			font-size: var(--font-size-xl, 1.5rem);
		}

		.article-sidebar--embedded :global(.article-sidebar__toc li),
		.article-sidebar--embedded :global(.article-sidebar__toc a) {
			font-size: var(--font-size-lg, 1.25rem);
		}
	}
</style>
