---
import { NAV_ROUTES } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.svelte';
---

<header class="site-header">
	<nav>
		<h2><a href="/" class="site-logo">BD</a></h2>
		<div class="internal-links">
			{NAV_ROUTES.map(({ href, label }) => (
				<HeaderLink href={href}>{label}</HeaderLink>
			))}
		</div>
		<ThemeToggle client:load />
	</nav>
</header>

<script>
	function normalizePath(pathname: string) {
		if (pathname.length > 1 && pathname.endsWith('/')) {
			return pathname.slice(0, -1);
		}
		return pathname || '/';
	}

	function updateNavLinks() {
		const pathname = normalizePath(window.location.pathname);
		const subpath = pathname.match(/[^/]+/g);

		document.querySelectorAll<HTMLAnchorElement>('.internal-links .nav-link').forEach((link) => {
			const href = link.getAttribute('href');
			if (!href) return;

			const isActive =
				href === pathname || href === '/' + (subpath?.[0] || '');
			link.classList.toggle('active', isActive);
		});
	}

	document.addEventListener('astro:page-load', updateNavLinks);
</script>
