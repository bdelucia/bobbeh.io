---
import { Code } from 'astro:components';

interface Props {
	content: string;
	language?: string;
}

const { content, language = 'plaintext' } = Astro.props;
const lang = language || 'plaintext';
---

<div class="code-block" data-code-block>
	<button
		type="button"
		class="code-block__copy"
		data-code-copy
		aria-label="Copy code"
	>
		<span class="code-block__icon code-block__icon--copy" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor">
				<path
					d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
				></path>
			</svg>
		</span>
		<span class="code-block__icon code-block__icon--check" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor">
				<path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"></path>
			</svg>
		</span>
	</button>
	<Code
		code={content}
		lang={lang as 'plaintext'}
		themes={{ light: 'github-light', dark: 'github-dark' }}
		wrap
	/>
</div>

<script>
	function bindCodeCopyButtons() {
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-code-copy]')) {
			if (button.dataset.bound === 'true') continue;
			button.dataset.bound = 'true';

			button.addEventListener('click', async () => {
				const block = button.closest('[data-code-block]');
				const code = block?.querySelector('pre')?.textContent ?? '';

				try {
					await navigator.clipboard.writeText(code);
					button.dataset.copied = 'true';
					button.setAttribute('aria-label', 'Copied');

					window.setTimeout(() => {
						delete button.dataset.copied;
						button.setAttribute('aria-label', 'Copy code');
					}, 2000);
				} catch {
					// Clipboard may be unavailable in some contexts
				}
			});
		}
	}

	bindCodeCopyButtons();
	document.addEventListener('astro:page-load', bindCodeCopyButtons);
</script>

<style>
	.code-block {
		position: relative;
		margin: 0 0 var(--size-6, 2rem);
	}

	.code-block :global(pre.astro-code) {
		margin: 0;
		padding-right: 3rem;
	}

	.code-block__copy {
		position: absolute;
		top: 50%;
		right: var(--size-2, 0.5rem);
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--border-subtle, #d1cfcd);
		border-radius: var(--radius-sm, 0.25rem);
		background: color-mix(in srgb, var(--bg-base, #f6f5f4) 88%, transparent);
		color: var(--text-muted, #55545f);
		line-height: 1;
		cursor: pointer;
		opacity: 0.85;
		transform: translateY(-50%);
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease,
			opacity 0.15s ease;
	}

	.code-block:hover .code-block__copy,
	.code-block__copy:focus-visible {
		opacity: 1;
	}

	.code-block__copy:hover,
	.code-block__copy:focus-visible {
		background: var(--bg-surface-hover, #dfdddb);
		color: var(--text-primary, #1c1b22);
		border-color: var(--border-accent, #3584e4);
	}

	.code-block__copy:focus-visible {
		outline: 2px solid var(--border-accent, #3584e4);
		outline-offset: 2px;
	}

	.code-block__copy[data-copied] {
		color: var(--alert-success, #2ea043);
		border-color: var(--alert-success, #2ea043);
	}

	.code-block__icon {
		display: inline-flex;
		font-size: 1rem;
	}

	.code-block__icon--check,
	.code-block__copy[data-copied] .code-block__icon--copy {
		display: none;
	}

	.code-block__copy[data-copied] .code-block__icon--check {
		display: inline-flex;
	}
</style>
