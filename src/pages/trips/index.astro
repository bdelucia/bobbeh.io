---
import { getCollection } from 'astro:content';
import TripCard from '../../components/TripCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle, TRIPS_DESCRIPTION } from '../../consts';
import { isPublishedTrip, sortTripsByStartDate } from '../../utils/trips';

const trips = (await getCollection('trips')).filter(isPublishedTrip).sort(sortTripsByStartDate);
---

<BaseLayout title={pageTitle('Trips')} description={TRIPS_DESCRIPTION}>
	<section class="trip-list" aria-labelledby="trips-heading">
		<header class="trip-list__header">
			<h1 id="trips-heading">Trips</h1>
			<p>{TRIPS_DESCRIPTION}</p>
		</header>
		<ul class="trip-list__grid">
			{trips.map((trip, index) => (
				<li>
					<TripCard trip={trip} featured={index === 0} />
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.trip-list {
		width: 960px;
		max-width: 100%;
		margin: 0 auto;
	}

	.trip-list__header {
		margin-bottom: var(--size-5, 1.5rem);
	}

	.trip-list__header h1 {
		margin: 0 0 var(--size-2, 0.5rem);
		font-size: var(--font-size-2xl, 2rem);
		line-height: var(--line-height-tight, 1.25);
	}

	.trip-list__header p {
		margin: 0;
		color: var(--text-muted, #55545f);
		font-size: var(--font-size-lg, 1.125rem);
		line-height: var(--line-height-normal, 1.5);
	}

	.trip-list__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--size-6, 2rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.trip-list__grid > li:first-child {
		grid-column: 1 / -1;
	}

	@media (max-width: 720px) {
		.trip-list__grid {
			grid-template-columns: 1fr;
			gap: var(--size-4, 1rem);
		}
	}
</style>
