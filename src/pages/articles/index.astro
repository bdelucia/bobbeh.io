---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticlesToolbar from '../../components/ArticlesToolbar.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { isPublishedArticle, sortArticlesByPublishDate } from '../../utils/articles';

const posts = (await getCollection('articles')).filter(isPublishedArticle).sort(sortArticlesByPublishDate);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="article-list">
		<ArticlesToolbar client:load />
		<ul id="article-list-grid" class="article-list__grid">
			{posts.map((post, index) => (
				<li data-article-item data-article-title={post.data.title}>
					<ArticleCard article={post} featured={index === 0} />
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.article-list {
		width: 960px;
		max-width: 100%;
		margin: 0 auto;
	}

	.article-list__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--size-6, 2rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.article-list__grid > li:first-child {
		grid-column: 1 / -1;
	}

	@media (max-width: 720px) {
		.article-list__grid {
			grid-template-columns: 1fr;
			gap: var(--size-4, 1rem);
		}
	}
</style>
