---
import { getEntry, render } from 'astro:content';
import { USES_DESCRIPTION } from '../consts';
import ContentPage from '../layouts/ContentPage.astro';

const page = await getEntry('uses', 'index');
if (!page) {
	throw new Error('Uses page content not found.');
}

const { Content } = await render(page);
const description = page.data.description || USES_DESCRIPTION;
---

<ContentPage title={page.data.title} description={description}>
	<Content />
</ContentPage>
